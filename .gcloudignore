# Ignore build and deployment scripts.
# NOTE: this excludes bin/ from `gcloud builds submit` / `gcloud run deploy
# --source` uploads. A `!bin/monitoring/` negation does NOT work here: gcloud's
# git-mode file enumeration silently drops `!` re-includes under an excluded
# dir (verified 2026-07-04 via `gcloud meta list-files-for-upload`). The
# monitoring Cloud Run job images (pipeline-canary, drift-alerter, auto-cleanup)
# COPY bin/monitoring/, so they MUST be built with a LOCAL `docker build`
# (reads the real filesystem, ignores this file), NOT `gcloud builds submit`.
# See bin/monitoring/rebuild_canary_image.sh.
bin/
docs/
.git/
.github/
*.md

# Claude Code agent worktrees: full repo copies, untracked, and they carry stale
# symlinks. Without this every manual `gcloud builds submit` uploads them AND
# crashes on their dangling links (see .pre-commit-hooks/validate_cloud_function_symlinks.py).
.claude/

# Ignore Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Ignore IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore test files
tests/
*_test.py
test_*.py

# Ignore environment files
.env
.env.*
venv/
.venv/
env/
ENV/
models/
